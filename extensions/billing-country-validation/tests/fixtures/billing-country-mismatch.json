{
  "payload": {
    "export": "cart-validations-generate-run",
    "target": "cart.validations.generate.run",
    "input": {
      "cart": {
        "billingAddress": {
          "countryCode": "US"
        }
      },
      "validation": {
        "metafield": {
          "jsonValue": {
            "enabled": true,
            "countryCode": "GB",
            "countryName": "United Kingdom",
            "errorMessage": "Billing country must be {country}. Choose {country} to continue."
          }
        }
      }
    },
    "output": {
      "operations": [
        {
          "validationAdd": {
            "errors": [
              {
                "message": "Billing country must be United Kingdom. Choose United Kingdom to continue.",
                "target": "$.cart.billingAddress.countryCode"
              }
            ]
          }
        }
      ]
    }
  }
}
