{
  "payload": {
    "export": "cart-validations-generate-run",
    "target": "cart.validations.generate.run",
    "input": {
      "cart": {
        "billingAddress": null
      },
      "validation": {
        "metafield": {
          "jsonValue": {
            "enabled": true,
            "countryCode": "GB",
            "countryName": "United Kingdom",
            "errorMessage": "Billing country must be {country}."
          }
        }
      }
    },
    "output": {
      "operations": [
        {
          "validationAdd": {
            "errors": []
          }
        }
      ]
    }
  }
}
